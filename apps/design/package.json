{
  "name": "design",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone Git Stacks design-system catalog (Quiet Workbench), backed by @git-stacks/ui",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5299 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5299 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run check:manifest && pnpm run test:catalog",
    "test:catalog": "playwright test",
    "check:manifest": "node scripts/check-manifest.mjs"
  },
  "dependencies": {
    "@git-stacks/ui": "workspace:*",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "2.15.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
