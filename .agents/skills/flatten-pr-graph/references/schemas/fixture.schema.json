{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/howarewoo/git-stacks/flatten-pr-graph/fixture.schema.json",
  "title": "flatten-pr-graph/1 authoring fixture declaration",
  "description": "A fixture declares its scenario, the outcome a conforming run must produce, and the invariant the oracle must be able to detect when the observed state is wrong. The oracle reads real repository and fake-provider state; this declaration is the expectation it judges that state against.",
  "$defs": {
    "contractVersion": {
      "const": "flatten-pr-graph/1"
    },
    "prNumber": {
      "type": "integer",
      "minimum": 1
    },
    "refName": {
      "type": "string",
      "pattern": "^refs/heads/.+"
    },
    "allowedAction": {
      "enum": [
        "read-pr-metadata",
        "list-pull-requests",
        "read-ref",
        "read-ancestry",
        "read-landing-arrangement",
        "write-task-owned-scratch",
        "update-pr-base",
        "push-selected-head"
      ]
    },
    "forbiddenAction": {
      "enum": [
        "run-checks",
        "await-checks",
        "rerun-checks",
        "weaken-protection",
        "merge-pr",
        "close-pr",
        "reopen-pr",
        "delete-branch",
        "push-root",
        "disable-auto-merge",
        "join-merge-queue",
        "modify-workflow-config",
        "edit-user-checkout",
        "edit-user-config",
        "write-unselected-ref",
        "write-outside-scratch",
        "clone-recreate-pr",
        "drop-selection",
        "expand-selection"
      ]
    },
    "invariant": {
      "enum": [
        "selection.complete",
        "selection.no-expansion",
        "topology.chain",
        "topology.dependencies",
        "preservation.root",
        "preservation.unselected-refs",
        "preservation.original-commits",
        "preservation.cumulative",
        "preservation.user-worktree",
        "integrity.clean",
        "remote.claims-match",
        "remote.actions-permitted",
        "status.legality"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "title", "matrixEntry", "kind", "selection", "expect"],
  "properties": {
    "contractVersion": {
      "$ref": "#/$defs/contractVersion"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "matrixEntry": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["matrix", "mutation"]
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "permittedActions",
        "forbiddenActions",
        "preserved",
        "chain",
        "mustDetectInvariant",
        "honestResult"
      ],
      "properties": {
        "status": {
          "enum": ["planned", "prepared", "published", "no-op", "blocked", "partial"]
        },
        "intent": {
          "enum": ["preview", "execute"]
        },
        "permittedActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allowedAction"
          }
        },
        "forbiddenActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/forbiddenAction"
          }
        },
        "chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prNumber"
          }
        },
        "preserved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "unselectedRefs", "userWorkspace"],
          "properties": {
            "root": {
              "type": "boolean"
            },
            "unselectedRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "userWorkspace": {
              "type": "boolean"
            }
          }
        },
        "mustDetectInvariant": {
          "$ref": "#/$defs/invariant"
        },
        "honestResult": {
          "description": "false when the result document under test lies about the seeded state, so the oracle must reject it.",
          "type": "boolean"
        },
        "retainedOriginalCommits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lostOriginalCommits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedCode": {
          "enum": [
            "missing-selection",
            "unsupported-input",
            "missing-permission",
            "missing-external-prerequisite",
            "missing-history",
            "contradictory-graph",
            "ambiguous-ownership",
            "stale-snapshot",
            "active-landing-arrangement",
            "unresolved-conflict",
            "conflicting-environment-control",
            "lost-original-commit"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "rubric"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
