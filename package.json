{
  "name": "git-stacks",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop workbench for Git branches and stacked pull requests",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bench:performance": "tsx scripts/perf/run-benchmarks.ts",
    "test:controls": "npm run build && electron --headless --no-sandbox --disable-gpu scripts/design-system-controls-smoke.cjs",
    "tokens:generate": "node src/renderer/src/design-system/generate-tokens.mjs",
    "tokens:check": "node src/renderer/src/design-system/generate-tokens.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check . '!./.github/workflows/pullfrog.yml'",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "dev.gitstacks.desktop",
    "productName": "Git Stacks",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
