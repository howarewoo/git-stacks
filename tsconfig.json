{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "electron-vite/node", "vite/client"],
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/**/*", "tests/**/*", "electron.vite.config.ts"]
}
